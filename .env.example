# EventOps environment configuration — TEMPLATE.
# Copy this file to `.env` (a working .env with dev defaults is also
# included already — see README.md) and fill in your own values.

# --- Flask ------------------------------------------------------------------
# Signs session cookies and CSRF tokens. Generate a fresh one for anything
# beyond local experimentation:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# --- MongoDB ------------------------------------------------------------------
# Local MongoDB:
MONGO_URI=mongodb://localhost:27017/eventops
# MongoDB Atlas (cloud) — required for Render/Vercel deployment:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=eventops

# --- App behaviour --------------------------------------------------------------
APP_NAME=EventOps
# Radius (meters) pre-filled on the "new event" form; each event can still
# override this individually.
DEFAULT_GEOFENCE_RADIUS_METERS=100

# --- Local dev server -----------------------------------------------------------
FLASK_DEBUG=True
PORT=5000

# --- Cookies ------------------------------------------------------------------
# False for local http://localhost. Set to True in your hosting platform's
# environment variables once the app is served over HTTPS — see README.md
# > "Deploying to production".
SESSION_COOKIE_SECURE=False
SESSION_LIFETIME_SECONDS=28800
