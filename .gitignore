# Environment secrets — the .env shipped in this project has working local
# defaults so the app runs immediately, but if you put this project under
# git / push it to GitHub (e.g. to deploy on Render or Vercel), keep it
# gitignored and set the same variables in your hosting platform's
# dashboard instead. Never commit a real SECRET_KEY or MONGO_URI.
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Vercel build artifact (regenerated by build_static.py, see pyproject.toml)
/public/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
